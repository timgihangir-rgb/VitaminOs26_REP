; src/bootldr/layout.inc
;
; Раскладка устанавливаемой системы на диске и карта низкой памяти
; загрузчика. Файл включается и в stage1, и в stage2, и в host-скрипт,
; который собирает тестовый диск, поэтому все числа живут здесь.
;
; Раскладка диска:
;
;   LBA 0            MBR: stage1 (512 Б) + таблица разделов + 0x55AA
;   LBA 1..16        stage2 (STAGE2_SECTORS секторов = 8 КиБ)
;   LBA 17..255      запас
;   LBA 256..        ELF-образ ядра
;   LBA ..PART1_LBA  запас под ядро (debug-сборка ~7.6 МиБ)
;   LBA PART1_LBA..  раздел 1: VITAFS до конца диска
;
; Между stage2 и ядром и между ядром и разделом оставлен запас: ядро
; в debug-сборке занимает ~7.6 МиБ, то есть LBA 256..~16600.
; Раздел начинается с 16 МиБ (32768 секторов) - на настоящем диске это
; ничто, зато размер ядра перестаёт быть ограничением.

STAGE2_LBA       equ 1
STAGE2_SECTORS   equ 16
KERNEL_LBA       equ 256
PART1_LBA        equ 32768

; ---------------------------------------------------------------------------
; Низкая память загрузчика. Всё, что ниже 1 МиБ, нужно и снять до
; включения A20, поэтому адреса жёсткие.
;
;   0x7C00..0x7E00  stage1 (сектор загрузки, остаётся лежать после прыжка)
;   0x7DF0          номер загрузочного привода, который пишет BIOS в DL.
;                   stage1 кладёт его по этому адресу, stage2 читает.
;   0x7E00..0x7E0F  пакет дискового адреса (DAP) для INT 13h AH=42h
;   0x8000..        stage2 (STAGE2_LOAD_OFF)
;   0xA000..0xA4FF  сырые записи E820 по 20 байт (E820_MAX штук)
;   0xA500..0xA6FF  ответ INT 10h AX=4F00 (VBE_INFO, 512 байт)
;   0xA700..0xA7FF  ответ INT 10h AX=4F01 (VBE_MODE_INFO, 256 байт)
;   0xA800..        multiboot2-инфо (теги строятся подряд, до ~1.6 КиБ)
;   0xB000..0xB700  копия таблицы программных заголовков ELF
;   0x5000          вершина стека защищённого режима (стек растёт вниз)
;   0x1000..0x1310  VBE: ответы INT 10h и состояние подбора режима
;   0x100000..0x104000  буфер чтения 16 КиБ
;
; Адрес в DAP - это пара 16-битных сегмент:смещение. BIOS вычисляет
; линейный адрес как seg*16+off в реальном режиме, поэтому буфер чтения
; обязан лежать ниже 1 МиБ. Ядро лежит по 2 и 4 МиБ, поэтому читаем в
; буфер, а оттуда копируем уже из защищённого режима.
;
; Буфер выровнен на 64 КиБ (0x10000 = 0x1000:0x0000), чтобы DAP-адрес
; выражался целым сегментом без значащего смещения. 16 КиБ (0x10000..
; 0x14000) свободны: stage2 кончается на ~0x8800, а E820/multiboot2
; начинаются с 0xA000.
;
; Копия phdr нужна потому, что разбирать их приходится уже после того, как
; буфер чтения занят первым же сегментом: исходные заголовки лежат в
; начале образа ядра, а загрузка сегментов буфер перезаписывает.

STAGE2_LOAD_OFF  equ 0x8000      ; куда stage1 кладёт stage2 (реальный режим)
BOOT_DRIVE_OFF   equ 0x1F0       ; смещение номера привода внутри сектора
BOOT_DRIVE_ADDR  equ 0x7C00 + BOOT_DRIVE_OFF
DAP_ADDR         equ 0x7E00

BUF_ADDR         equ 0x10000     ; ниже 1 МиБ: адресуется BIOS'ом в DAP
BUF_BYTES        equ 0x4000      ; 16 КиБ
BUF_SECTORS      equ BUF_BYTES / 512

E820_BUF         equ 0xA000
E820_MAX         equ 64          ; столько же, сколько держит ядро (MAX_REGIONS)
MB_INFO          equ 0xA800
PHDR_BUF         equ 0xB000
PHDR_MAX         equ 32
PHDR_BYTES       equ PHDR_MAX * 56
STACK_TOP        equ 0x5000

; VBE. Свой загрузчик не умеет читать EDID, поэтому режим подбирает по
; списку BIOS: максимальное разрешение, при равенстве - больше бит на пиксель.
;
; Адреса обязаны быть НИЖЕ 0x8000: код выбора режима написан в 16-битном
; режиме и обращается к буферам через смещение ModRM, а NASM молча обрезает
; его до 16 бит. При 0xA500 или 0x20000 обращения уезжали на 0x2500/0x0000,
; и в "сведениях о режиме" оказывались байты самого загрузчика.
;
; Прочий низ памяти занят: 0x400 векторы/BIOS, 0x7C00 stage1, 0x7E00 DAP,
; 0x8000 stage2, 0xA000 E820, 0xA800 multiboot2-инфо, 0xB000 phdr. Окно VGA
; 0xA0000..0xBFFFF и BIOS-scratch обходятся стороной.
VBE_INFO         equ 0x1000       ; VbeInfo, 512 байт (AX=4F00)
VBE_MODES        equ 0x1200       ; VbeModeInfo, 256 байт (AX=4F01)
VBE_OK           equ 0x1300       ; dw: 1 - графический режим включён
VBE_BEST_MODE    equ 0x1302       ; dw: номер выбранного режима
VBE_BEST_PIX     equ 0x1304       ; dd: разрешение в пикселях
VBE_BEST_BPP     equ 0x1308       ; db: бит на пиксель
VBE_MODE_CNT     equ 0x130A       ; dw: сколько режимов перечислено
VBE_IDX          equ 0x130C       ; dw: индекс перебираемого режима
VBE_RET          equ 0x130E       ; dw: результат последнего INT 10h

; Ячейки, общие для защищённого режима и 16-битного трамплина BIOS.
BIOS_CF          equ 0x7F00      ; результат INT 13h (CF), пишет трамплин
SAVED_ESP        equ 0x7F04      ; стек pmode, сохраняется перед INT 13h
